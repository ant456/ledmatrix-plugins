{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {"type": "boolean", "default": true, "description": "Run the portal"},
    "portal_port": {"type": "integer", "default": 5020, "minimum": 1024, "maximum": 65535, "description": "Port for the Govee Lights web page"},
    "display_duration": {"type": "number", "default": 1, "minimum": 1, "maximum": 5, "description": "Unused: this plugin shows nothing on the panel"}
  },
  "additionalProperties": true
}

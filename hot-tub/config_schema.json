    "mqtt_password": {
      "type": "string",
      "title": "MQTT Password",
      "default": ""
    },
    "show_filter": {
      "type": "boolean",
      "title": "Show Filter Indicator",
      "default": true
    },
    "show_bubbles": {
      "type": "boolean",
      "title": "Show Bubbles Indicator",
      "default": true
    },
    "show_heater": {
      "type": "boolean",
      "title": "Show Heater Indicator",
      "default": true
    },
    "display_duration": {
      "type": "integer",
      "title": "Display Duration (seconds)",
